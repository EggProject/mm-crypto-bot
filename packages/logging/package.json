{
  "name": "@mm-crypto-bot/logging",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json --noEmit",
    "lint": "eslint src test-support test/e2e --max-warnings=0",
    "test": "vitest run --config vitest.config.ts",
    "coverage:unit": "vitest run --config vitest.config.ts --coverage",
    "coverage:e2e": "bun test/e2e/run-logging-e2e-coverage-cli.ts",
    "coverage": "bun run coverage:unit && bun run coverage:e2e"
  },
  "devDependencies": {
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-instrument": "1.7.8",
    "@vitest/coverage-v8": "4.1.10",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
