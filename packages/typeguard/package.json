{
  "name": "@mm-crypto-bot/typeguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts",
    "coverage": "vitest run --config vitest.config.ts --coverage",
    "coverage:unit": "vitest run --config vitest.config.ts --coverage",
    "coverage:text": "vitest run --config vitest.config.ts --coverage",
    "coverage:lcov": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@mm-crypto-bot/typing": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "vitest": "4.1.10",
    "typescript": "6.0.3"
  }
}
