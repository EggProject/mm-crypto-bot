{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "rootDir": "../.."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mts",
    "src/**/*.cts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "test/**/*.mts",
    "test/**/*.cts"
  ],
  "exclude": ["dist", "node_modules", "coverage", ".turbo"]
}
