{
  "name": "@mm-crypto-bot/bot",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outdir=dist --format=esm",
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "bun test src",
    "coverage": "bun ../../scripts/coverage-tools/run-bot-unit-coverage.ts",
    "coverage:unit": "bun ../../scripts/coverage-tools/run-bot-unit-coverage.ts",
    "coverage:e2e": "bun ../../scripts/coverage-tools/run-bot-e2e-coverage.ts",
    "clean": "rm -rf .turbo *.tsbuildinfo dist coverage"
  },
  "dependencies": {
    "@mm-crypto-bot/backtest": "workspace:*",
    "@mm-crypto-bot/core": "workspace:*",
    "@mm-crypto-bot/exchange": "workspace:*",
    "@mm-crypto-bot/paper": "workspace:*",
    "@mm-crypto-bot/shared": "workspace:*",
    "picocolors": "1.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
