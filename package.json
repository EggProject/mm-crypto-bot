{
  "name": "mm-crypto-bot",
  "version": "0.0.0",
  "private": true,
  "description": "Bun + Turborepo + TS ultra-strict monorepo scaffold az mm-crypto-bot projekthez",
  "type": "module",
  "engines": {
    "bun": "1.3.14",
    "node": "24.19.0"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "backtest": "bun run --filter @mm-crypto-bot/backtest-tools baseline",
    "sweep": "bun run --filter @mm-crypto-bot/backtest-tools sweep",
    "oos": "bun run --filter @mm-crypto-bot/backtest-tools oos",
    "report": "bun run --filter @mm-crypto-bot/backtest-tools report",
    "ohlcv": "bun run --filter @mm-crypto-bot/backtest-tools download-ohlcv",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint --config eslint.config.js apps packages scripts search-best-config eslint.config.js --max-warnings=0",
    "lint:hook": "eslint --config eslint.config.js apps packages scripts search-best-config eslint.config.js --max-warnings=0",
    "clean:artifacts": "bun scripts/tooling/clean-artifacts.ts",
    "clean:artifacts:dry-run": "bun scripts/tooling/clean-artifacts.ts --dry-run",
    "worktree:inspect": "bun scripts/tooling/worktree-inspection.ts",
    "hook:pre-commit": "bun scripts/tooling/pre-commit-pipeline.ts",
    "hook:validate": "bun scripts/tooling/hook-contract.ts",
    "hook:bootstrap": "bun scripts/tooling/bootstrap.ts",
    "test:tooling": "bun test scripts/tooling/*.test.ts",
    "verify:foundation": "bun scripts/tooling/verify-foundation.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:install-warnings": "bash scripts/install-no-warnings.sh",
    "coverage": "bun run coverage:full",
    "coverage:bot:unit": "bun scripts/coverage-tools/run-bot-unit-coverage.ts",
    "coverage:bot:e2e": "bun scripts/coverage-tools/run-bot-e2e-coverage.ts",
    "coverage:scope": "bun scripts/coverage-tools/verify-bot-runtime-scope.ts",
    "typecheck:coverage-tools": "tsc --project tsconfig.json --noEmit",
    "test:coverage-infra": "bun test scripts/coverage-tools/*.test.ts",
    "coverage:per-package": "bash scripts/coverage-per-package.sh",
    "coverage:merge": "bun scripts/lcov-tools.mjs merge coverage/merged/lcov.info apps/bot/coverage/unit/lcov.info packages/paper/coverage/lcov.info packages/exchange/coverage/lcov.info packages/core/coverage/lcov.info packages/shared/coverage/lcov.info packages/backtest/coverage/lcov.info packages/backtest-tools/coverage/lcov.info packages/logging/coverage/unit/lcov.info",
    "coverage:report": "bun scripts/lcov-tools.mjs summary coverage/merged/lcov.info",
    "coverage:html": "genhtml coverage/merged/lcov.info -o coverage/merged/html --ignore-errors empty,inconsistent,source --legend",
    "coverage:enforce": "bun run coverage:per-package",
    "coverage:full": "bash scripts/coverage-full.sh",
    "clean": "turbo run clean && rm -rf node_modules .turbo coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/bases": "1.0.27",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-v8": "4.1.10",
    "bun-types": "1.3.14",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-unicorn": "73.0.0",
    "globals": "17.11.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "turbo": "2.10.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@mm-crypto-bot/logging": "workspace:*",
    "ccxt": "4.5.64",
    "protobufjs": "8.7.2",
    "smol-toml": "1.8.0",
    "write-file-atomic": "8.0.0"
  },
  "trustedDependencies": [
    "ccxt"
  ],
  "overrides": {
    "uuid": "11.1.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  }
}
