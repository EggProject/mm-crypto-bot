{
  "name": "ts-typing",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ts/typing/src",
  "projectType": "library",
  "tags": ["scope:ts", "type:utility"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/ts/typing",
        "main": "packages/ts/typing/src/index.ts",
        "tsConfig": "packages/ts/typing/tsconfig.lib.json",
        "assets": ["packages/ts/typing/*.md"],
        "generatePackageJson": true,
        "generateExportsField": true
      }
    }
  }
}
